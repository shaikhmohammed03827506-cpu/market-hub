# Koyeb exposes port 8080 from the Docker image.
PORT=8080
NODE_ENV=production

# Use a cloned Neon PostgreSQL database during staging. Never commit the real URL.
DATABASE_URL=postgresql://user:password@host/market_hub?sslmode=require

ADMIN_EMAIL=replace_with_admin_email
ADMIN_PASSWORD=replace_with_a_long_unique_password
SESSION_SECRET=replace_with_at_least_32_random_characters

RAZORPAY_KEY_ID=replace_with_test_key_id
RAZORPAY_KEY_SECRET=replace_with_test_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_test_webhook_secret

SHIPROCKET_CHECKOUT_API_KEY=replace_with_test_checkout_api_key
SHIPROCKET_CHECKOUT_SECRET_KEY=replace_with_test_checkout_secret
SHIPROCKET_CHECKOUT_BASE_URL=https://checkout-api.shiprocket.com
SHIPROCKET_CHECKOUT_WEBHOOK_SECRET=replace_with_test_checkout_webhook_secret

SHIPROCKET_API_EMAIL=replace_with_test_shiprocket_email
SHIPROCKET_API_PASSWORD=replace_with_test_shiprocket_password
SHIPROCKET_CHANNEL_ID=0
SHIPROCKET_API_BASE_URL=https://apiv2.shiprocket.in
SHIPROCKET_PICKUP_LOCATION=replace_with_test_pickup_location
SHIPROCKET_PICKUP_PINCODE=000000

DELHIVERY_API_TOKEN=replace_if_used
DELHIVERY_PICKUP_LOCATION=replace_if_used
DELHIVERY_COD_ENABLED=false

STORE_LOGO_URL=https://example.com/logo.png
