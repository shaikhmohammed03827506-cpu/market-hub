# The Docker image listens on port 8080 for Back4app Containers.
PORT=8080
NODE_ENV=production
DATABASE_URL=postgresql://user:password@host:5432/market_hub

ADMIN_EMAIL=replace_with_admin_email
ADMIN_PASSWORD=replace_with_a_long_unique_password

RAZORPAY_KEY_ID=replace_with_key_id
RAZORPAY_KEY_SECRET=replace_with_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret

SHIPROCKET_CHECKOUT_API_KEY=replace_with_checkout_api_key
SHIPROCKET_CHECKOUT_SECRET_KEY=replace_with_checkout_secret
SHIPROCKET_CHECKOUT_BASE_URL=https://checkout-api.shiprocket.com
SHIPROCKET_CHECKOUT_WEBHOOK_SECRET=replace_with_checkout_webhook_secret

SHIPROCKET_API_EMAIL=replace_with_shiprocket_email
SHIPROCKET_API_PASSWORD=replace_with_shiprocket_password
SHIPROCKET_CHANNEL_ID=0
SHIPROCKET_API_BASE_URL=https://apiv2.shiprocket.in
SHIPROCKET_PICKUP_LOCATION=replace_with_pickup_location
SHIPROCKET_PICKUP_PINCODE=000000

DELHIVERY_API_TOKEN=replace_if_used
DELHIVERY_PICKUP_LOCATION=replace_if_used
DELHIVERY_COD_ENABLED=false

STORE_LOGO_URL=https://example.com/logo.png
