{
  "name": "market-hub-render-launcher",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "start": "node app/server.js",
    "check": "node --check app/server.js && node --check app/script.js && node --check app/account.js",
    "test:importer": "node --test app/tests/product-import.test.js app/tests/product-import-errors.test.js app/tests/product-import-publish.test.js app/tests/product-import-publish-db.test.js",
    "test:session": "node --test app/tests/session-restart.test.js",
    "test:delhivery": "node --test app/tests/delhivery.test.js",
    "test:checkout": "node --test app/tests/checkout-gifts.test.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "pg": "^8.16.3"
  }
}
