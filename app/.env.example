# Copy this file to .env on the server, then replace only the placeholders.
# Never upload .env or send a Key Secret in chat.

# PostgreSQL production database. Keep this private and server-only.
DATABASE_URL=postgresql://market_hub_user:private_password@database-host:5432/market_hub

# Razorpay: Dashboard > Account & Settings > API Keys
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_private_key_secret
RAZORPAY_WEBHOOK_SECRET=choose_a_private_webhook_secret

# Delhivery One: Developer Portal > API token and registered pickup location.
DELHIVERY_API_TOKEN=replace_with_your_private_delhivery_token
DELHIVERY_PICKUP_LOCATION=replace_with_your_registered_pickup_location
DELHIVERY_COD_ENABLED=false

# Optional: full public URL of the MARKET HUB logo after deployment.
STORE_LOGO_URL=
